# RetailPulse .gitignore

# Environment — never commit credentials
.env
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Jupyter checkpoints
.ipynb_checkpoints/

# Large raw data files — regenerated by pipeline
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.parquet
!data/raw/.gitkeep

# Processed data — regenerated by pipeline
# Exception: clean CSV is tracked for Streamlit Cloud deployment
data/processed/*.parquet
!data/processed/retailpulse_clean.csv
!data/processed/.gitkeep

# Sample data — keep
!data/sample/*.csv
!data/sample/.gitkeep

# Excel binary — large, regenerated by script
excel/*.xlsx

# Logs and temp
*.log
*.tmp
*.bak

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/
*.code-workspace

# Pytest
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Streamlit secrets — never commit
.streamlit/secrets.toml
