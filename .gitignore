# RetailPulse .gitignore

# Environment
.env
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Large raw data files (do not commit to Git)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.parquet
# Keep gitkeep markers
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/sample/.gitkeep

# Processed data (regenerated by pipeline)
data/processed/*.parquet
data/processed/*.csv
# Exception: keep sample data
!data/sample/*.csv

# Excel output (large binary)
excel/*.xlsx

# Logs and temp
*.log
*.tmp
*.bak
tmp/
temp/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/
*.code-workspace

# Pytest
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Distribution
dist/
build/
*.egg-info/

# Streamlit
.streamlit/secrets.toml
