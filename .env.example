# RetailPulse — Environment Configuration
# Copy this file to .env and fill in your MySQL credentials
# NEVER commit .env to Git

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=retailpulse

# Optional: set to "csv" to bypass MySQL and load from processed CSV
DATA_SOURCE=mysql
