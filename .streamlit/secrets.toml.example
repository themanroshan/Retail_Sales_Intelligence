# Streamlit Cloud secrets — copy this structure into the Streamlit Cloud
# "Secrets" section (Settings > Secrets) when deploying.
# NEVER commit a real secrets.toml — this example file is safe.

# For CSV-only mode (no MySQL needed — use this for free Streamlit Cloud deployment):
DATA_SOURCE = "csv"

# For MySQL mode (requires a hosted MySQL instance):
# DATA_SOURCE = "mysql"
# MYSQL_HOST = "your-mysql-host.example.com"
# MYSQL_PORT = 3306
# MYSQL_USER = "your_user"
# MYSQL_PASSWORD = "your_password"
# MYSQL_DATABASE = "retailpulse"
